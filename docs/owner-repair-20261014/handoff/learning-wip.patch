+// Original learning activities, using the existing frame, art and gentle retry rules.
+import { register, choiceButtons, untilRight } from './frame.js';
+import { T } from '../i18n.js';
+import { pic } from '../art.js';
+import { el, shuffle, wait } from '../util.js';
+import { GAME_INFO } from '../content/activities.js';
+import { HOWTO } from '../howto.js';
+
+const tier = api => api.little ? 0 : api.level >= 3 ? 3 : api.level >= 2 ? 2 : 1;
+const INTRO = {
+  patternpicnic: ['Listen and look at the pattern. Choose the picture that comes next.', 'Nghe và nhìn quy luật. Chọn hình tiếp theo.'],
+  shapebuilders: ['Build the picture. Choose a shape, then tap its matching outline. You can drag the shape there too.', 'Ghép bức tranh. Chọn hình khối rồi chạm vào nét viền giống hình đó. Con cũng có thể kéo hình vào đó.'],
+  remembergarden: ['Look at the garden pictures. Put them back in the same order. You can see them again whenever you need.', 'Nhìn các hình trong vườn. Chọn lại theo đúng thứ tự. Con có thể xem lại bất cứ lúc nào.']
+};
+for (const [id, words] of Object.entries(INTRO)) {
+  GAME_INFO[id] = ['thinking', 3, 2]; HOWTO[id] = { steps: [{ pic: '🧩', en: words[0], vi: words[1] }] };
+}
+function repeat(api, speak) {
+  const button = el('button', 'btn bt-repeat', pic('🔁') + T('Hear again', 'Nghe lại'));
+  button.style.minHeight = '64px'; button.onclick = speak; api.stage.appendChild(button); return button;
+}
+const SYMBOLS = ['🍎', '🌸', '🐶', '🍌'];
+const NAMES = {'🍎':['Apple','Táo'],'🌸':['Flower','Hoa'],'🐶':['Dog','Chó'],'🍌':['Banana','Chuối'],'🌱':['Seedling','Cây non'],'💧':['Water','Nước'],'🌳':['Tree','Cây']};
+register({ id: 'patternpicnic', icon: '🧺', name: () => T('Pattern Picnic', 'Dã Ngoại Quy Luật'), async run(api) {
+  const patterns = [['🍎','🌸'], ['🍎','🍎','🌸'], ['🍎','🌸','🐶'], ['🍎','🌸','🌸','🐶']];
+  const level = tier(api), rounds = level === 0 ? 3 : 4;
+  for (let round = 0; round < rounds; round++) {
+    if (api.closed) return; api.stage.innerHTML = ''; api.dots(rounds, round);
+    const rule = patterns[Math.min(3, level === 0 ? 0 : level === 1 ? round % 2 : Math.min(level, round))];
+    const shift = round % rule.length, model = Array.from({ length: rule.length * 2 }, (_, i) => rule[(i + shift) % rule.length]);
+    const answer = rule[(model.length + shift) % rule.length];
+    const row = el('div', 'seq', model.map(value => `<span class="seq-item">${pic(value)}</span>`).join('') + '<span class="seq-item q">?</span>');
+    api.stage.appendChild(row); repeat(api, () => api.say(...INTRO.patternpicnic)); api.say(...INTRO.patternpicnic);
+    const options = shuffle([answer, ...SYMBOLS.filter(value => value !== answer).slice(0, level === 0 ? 1 : level === 3 ? 3 : 2)]);
+    const buttons = choiceButtons(api, options, value => pic(value)); buttons.forEach(b=>b.setAttribute('aria-label',T(...NAMES[b._v])));
+    if (!await untilRight(api, buttons, b => b._v === answer)) return;
+    row.lastElementChild.innerHTML = pic(answer); api.praise(); await wait(300);
+  }
+  return api.win();
+} });
+
+const SHAPES = {
+  triangle: ['Triangle', 'Tam giác', '<path d="M50 12L88 85H12Z"/>'],
+  square: ['Square', 'Hình vuông', '<rect x="15" y="15" width="70" height="70" rx="5"/>'],
+  circle: ['Circle', 'Hình tròn', '<circle cx="50" cy="50" r="35"/>'],
+  rectangle: ['Rectangle', 'Hình chữ nhật', '<rect x="10" y="27" width="80" height="46" rx="5"/>']
+};
+const shape = (key, filled = true) => `<svg viewBox="0 0 100 100" width="100%" height="100%" aria-hidden="true"><g fill="${filled ? '#ffd36a' : '#fff7e8'}" stroke="${filled ? '#6a4a8a' : '#b29cc5'}" stroke-width="5" ${filled ? '' : 'stroke-dasharray="7 5"'}>${SHAPES[key][2]}</g></svg>`;
+const PICTURES = [
+  [['triangle',80,4,120,88], ['square',90,75,100,112], ['circle',108,95,64,64]],
+  [['triangle',70,2,140,94], ['square',86,79,108,120], ['circle',93,88,64,64], ['rectangle',126,128,64,64]],
+  [['rectangle',10,61,192,112], ['square',152,9,110,110], ['circle',24,142,76,76], ['circle',151,142,76,76], ['square',172,28,64,64]],
+  [['rectangle',105,90,70,140], ['triangle',39,102,90,80], ['triangle',152,117,90,80], ['circle',84,31,112,112], ['circle',24,12,100,100], ['circle',155,11,100,100]]
+];
+register({ id: 'shapebuilders', icon: '🧩', name: () => T('Shape Builders', 'Ghép Tranh Hình Khối'), async run(api) {
+  const pieces = PICTURES[tier(api)], board = el('div', 'bt-picture');
+  board.style.cssText = 'position:relative;width:280px;max-width:100%;height:240px;margin:0 auto'; api.stage.appendChild(board);
+  let active = null, selected = null, dragging = null;
+  const slots = pieces.map(([key,x,y,w,h], i) => {
+    const b = el('button', 'bt-slot', shape(key, false)); b.dataset.shape = key; b.disabled = true;
+    b.setAttribute('aria-label', T(...SHAPES[key].slice(0,2))); b.style.cssText = `position:absolute;left:${x/2.8}%;top:${y}px;width:${w/2.8}%;height:${h}px;min-width:64px;min-height:64px;padding:0;background:transparent;border:0;pointer-events:none`;
